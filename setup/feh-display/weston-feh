#!/bin/sh
# ExecStart for feh-display.service: weston (kiosk shell: one fullscreen app, no launchers) on the GPU Waydroid
# renders on, as picked by feh-gpu (Waydroid's own rule; FEH_GPU in /etc/default/feh-dumper overrides it). Resolved
# at runtime, so a GPU swap or a renumbered card needs no edit here. weston's own log, including its
# "GL renderer:" line, goes to $XDG_RUNTIME_DIR/weston-feh.log.
set -eu
gpu=$(/usr/local/lib/feh-display/feh-gpu)
set -- $gpu   # render-node card-node driver
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
exec /usr/bin/weston --backend=drm-backend.so --drm-device="${2##*/}" --shell=kiosk-shell.so \
    --socket=wayland-waydroid --idle-time=0 --continue-without-input --log="${XDG_RUNTIME_DIR:-/tmp}/weston-feh.log"
