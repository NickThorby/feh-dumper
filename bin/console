#!/usr/bin/env bash
# Type a command into the shell logged in on the physical console (tty1), over SSH. For a box with a
# monitor + mouse but no keyboard: bin/display needs the console's logind seat, so it can't run over SSH
# directly, but typed into the console's own shell it runs in that session. Needs tty1 already logged
# in and sitting at a bash prompt. Uses TIOCSTI, which needs root on kernels without CONFIG_LEGACY_TIOCSTI.
#   bin/console                 run bin/display on the monitor (output also in logs/display.log)
#   bin/console '<command>'     type any command
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
CONSOLE_TTY=${CONSOLE_TTY:-tty1}
mkdir -p "$ROOT/logs"
cmd=${1:-"$ROOT/bin/display 2>&1 | tee $ROOT/logs/display.log"}

grep -qx connected /sys/class/drm/card*-*/status ||
  { echo "no monitor connected (see /sys/class/drm/card*-*/status)" >&2; exit 1; }
fg=$(ps -o tpgid=,pid=,comm= -t "$CONSOLE_TTY" | awk '$1 == $2 { print $3 }' || true)
[[ $fg == *bash ]] ||
  { echo "$CONSOLE_TTY isn't at a shell prompt (foreground: ${fg:-nothing}); log in there first" >&2; exit 1; }

sudo python3 - "/dev/$CONSOLE_TTY" "$cmd" <<'PY'
import fcntl, os, sys, termios
fd = os.open(sys.argv[1], os.O_RDWR | os.O_NOCTTY)
for b in (sys.argv[2] + "\n").encode():
    fcntl.ioctl(fd, termios.TIOCSTI, bytes([b]))
PY
echo "typed into $CONSOLE_TTY: $cmd"
