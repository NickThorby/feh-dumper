#!/usr/bin/env bash
# How to see and use the Android screen from another computer (scrcpy mirrors it over adb).
# Rides on Waydroid's flaky adbd: for menus, sign-in or language switching use bin/display instead.
source "$(dirname "$0")/_lib.sh"
ip=$(hostname -I | awk '{print $1}')
cat <<MSG
On the Mac (once: brew install scrcpy android-platform-tools):
  ssh -N -L 5999:$DEVICE $USER@$ip &
  adb connect localhost:5999 && scrcpy -s localhost:5999 --no-audio --force-adb-forward --max-fps 15
(Waydroid's adb is only reachable from this host, hence the tunnel; if it hangs: bin/session)
MSG
